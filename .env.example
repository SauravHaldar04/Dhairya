# ============================================================
# ENVIRONMENT VARIABLES - DO NOT COMMIT THIS FILE
# ============================================================
# This file contains sensitive credentials and should NEVER be committed to Git
# Copy this file to .env and fill in your actual values

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Firebase Configuration (for Flutter app)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_APP_ID=your_firebase_app_id_here
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# For Supabase Edge Functions (set via Supabase CLI, not in this file):
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key (use: supabase secrets set)
# FIREBASE_PRIVATE_KEY=your_private_key (use: supabase secrets set)
# FIREBASE_CLIENT_EMAIL=your_email (use: supabase secrets set)
